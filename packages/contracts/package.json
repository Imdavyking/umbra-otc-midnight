{
  "name": "@umbra-otc/contract",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "compact": "compact compile +0.36.1 src/htlc.compact src/managed/htlc",
    "build": "rm -rf dist && tsc --project tsconfig.build.json && cp -R ./src/managed ./dist/managed && cp ./src/*.compact dist",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:compile": "npm run compact && vitest run",
    "prepack": "yarn build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@umbra-otc/compact": "workspace:*",
    "eslint": "^9.27.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
